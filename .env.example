# Local dev: copy to .env.local and fill in.
# Production: managed in Vercel — `vercel env pull .env.local` pulls them down.

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=                 # verified Resend sender, e.g. noreply@cascaisvolley.com
VOLLEY4ALL_EMAIL_TO=        # registration submissions inbox (info@volley4all.com)
OSPORT_EMAIL_TO=            # accommodation inquiries inbox (info@o-sports.pt)

# Cloudinary (gallery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — overrides the production SITE_URL used by metadata + sitemap.
# Defaults to https://cascaisvolley.com.
NEXT_PUBLIC_SITE_URL=

# Sanity (news CMS)
# Created via `npx sanity@latest init --bare` — see CLAUDE.md "Sanity / news".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Write token (Settings → API → Tokens, Editor role). Only used by scripts/seed-news.mjs.
SANITY_WRITE_TOKEN=
# Webhook secret (Settings → API → Webhooks). Used by /api/revalidate to verify HMAC.
SANITY_WEBHOOK_SECRET=
